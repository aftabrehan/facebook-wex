# Local: http://localhost:3000. Production: your deployed HTTPS origin.
NEXTAUTH_URL=http://localhost:3000
# Generate a strong random secret and configure the same value in Vercel.
NEXTAUTH_SECRET=

# Optional OAuth providers. Configure both values to enable each provider.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase web app configuration (public identifiers, not admin credentials).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
